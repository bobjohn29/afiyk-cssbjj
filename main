cat > src/App.jsx <<'EOF'
import { useState } from "react";
import { motion } from "framer-motion";
import {
  Home,
  Users,
  UserPlus,
  Flame,
  User,
  Leaf,
  Lock,
  Search,
  Copy,
  Trophy,
} from "lucide-react";
import "./style.css";

const friends = [
  { name: "Maya", streak: 12, status: "Currently in Grass Mode" },
  { name: "Leo", streak: 9, status: "Last active 2h ago" },
  { name: "Sam", streak: 4, status: "Needs encouragement" },
];

function App() {
  const [screen, setScreen] = useState("loading");

  setTimeout(() => {
    if (screen === "loading") setScreen("welcome");
  }, 1800);

  return (
    <div className="app">
      {screen === "loading" && <Loading />}
      {screen === "welcome" && <Welcome setScreen={setScreen} />}
      {screen === "signup" && <Signup setScreen={setScreen} />}
      {screen === "login" && <Login setScreen={setScreen} />}
      {screen === "home" && <HomeScreen setScreen={setScreen} />}
      {screen === "grass" && <GrassMode />}
      {screen === "friends" && <Friends />}
      {screen === "add" && <AddFriends />}
      {screen === "streak" && <Streak />}
      {screen === "profile" && <Profile />}
      {!["loading", "welcome", "signup", "login"].includes(screen) && (
        <BottomNav screen={screen} setScreen={setScreen} />
      )}
    </div>
  );
}

function Page({ children }) {
  return (
    <motion.main
      className="page"
      initial={{ opacity: 0, y: 18 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.35 }}
    >
      {children}
    </motion.main>
  );
}

function Loading() {
  return (
    <div className="center">
      <motion.div
        className="logoGlow"
        animate={{ scale: [1, 1.12, 1] }}
        transition={{ repeat: Infinity, duration: 1.4 }}
      >
        <Leaf size={54} />
      </motion.div>
      <h1>Touch Grass</h1>
      <p>Loading your sunlight...</p>
    </div>
  );
}

function Welcome({ setScreen }) {
  return (
    <Page>
      <div className="hero">
        <Leaf size={46} />
        <h1>Stay offline. Go outside. Beat your friends.</h1>
        <p>
          Build streaks by reducing screen time and spending more time in the
          real world.
        </p>
        <div className="phoneArt">
          <Lock size={52} />
          <span>🌱 🌱 🌱</span>
        </div>
        <button onClick={() => setScreen("signup")}>Create Account</button>
        <button className="ghost" onClick={() => setScreen("login")}>
          Log In
        </button>
      </div>
    </Page>
  );
}

function Signup({ setScreen }) {
  return (
    <Page>
      <h2>Create your account</h2>
      <p>Start your first streak today.</p>
      <Input label="Username" />
      <Input label="Email" />
      <Input label="Password" type="password" />
      <Input label="Confirm Password" type="password" />
      <button onClick={() => setScreen("home")}>Start Touching Grass</button>
      <button className="link" onClick={() => setScreen("login")}>
        Already have an account? Log in
      </button>
    </Page>
  );
}

function Login({ setScreen }) {
  return (
    <Page>
      <h2>Welcome back 🔥</h2>
      <p>Your streak missed you.</p>
      <Input label="Email" />
      <Input label="Password" type="password" />
      <button onClick={() => setScreen("home")}>Log In</button>
      <button className="ghost">Continue with Apple</button>
      <button className="ghost">Continue with Google</button>
    </Page>
  );
}

function HomeScreen({ setScreen }) {
  return (
    <Page>
      <h2>Good evening, A</h2>

      <section className="bigCard">
        <Flame size={38} />
        <h1>7 Day Streak</h1>
        <p>You stayed under your limit today.</p>
      </section>

      <section className="progress">
        <div className="ring">74%</div>
        <p>2h 13m / 3h daily limit</p>
      </section>

      <button onClick={() => setScreen("grass")}>Start Grass Mode</button>

      <div className="grid">
        <Card title="Offline" value="5h 42m" />
        <Card title="Points" value="1,240" />
        <Card title="Rank" value="#3" />
      </div>

      <h3>Friends This Week</h3>
      {friends.map((f, i) => (
        <motion.div
          className="friend"
          key={f.name}
          initial={{ opacity: 0, x: -16 }}
          animate={{ opacity: 1, x: 0 }}
          transition={{ delay: i * 0.1 }}
        >
          <strong>{i + 1}. {f.name}</strong>
          <span>{f.streak} days</span>
        </motion.div>
      ))}
    </Page>
  );
}

function GrassMode() {
  return (
    <Page>
      <h2>Grass Mode</h2>
      <div className="timer">01:30:00</div>
      <p>Phone down. Life up.</p>

      <div className="chips">
        <span>30 min</span>
        <span>1 hour</span>
        <span>2 hours</span>
        <span>Custom</span>
      </div>

      <button>Begin Session</button>
      <button className="ghost danger">Emergency Unlock</button>
    </Page>
  );
}

function Friends() {
  return (
    <Page>
      <h2>Friends</h2>
      <section className="bigCard">
        <Users />
        <h3>Squad Streak</h3>
        <p>Your group has stayed consistent for 18 days.</p>
      </section>

      {friends.map((f) => (
        <div className="friendCard" key={f.name}>
          <div className="avatar">{f.name[0]}</div>
          <div>
            <h3>{f.name}</h3>
            <p>🔥 {f.streak} day streak</p>
            <small>{f.status}</small>
          </div>
          <button className="mini">Nudge</button>
        </div>
      ))}
    </Page>
  );
}

function AddFriends() {
  return (
    <Page>
      <h2>Add Friends</h2>
      <div className="search">
        <Search size={18} />
        <input placeholder="Search username or email" />
      </div>

      <section className="invite">
        <p>Your invite code</p>
        <h1>A73-GRASS</h1>
        <button className="ghost">
          <Copy size={16} /> Copy
        </button>
      </section>

      <button>Invite Contacts</button>
      <button className="ghost">Share Link</button>

      <h3>People you may know</h3>
      {["Nina", "Tom"].map((name) => (
        <div className="friend" key={name}>
          <strong>{name}</strong>
          <button className="mini">Add</button>
        </div>
      ))}
    </Page>
  );
}

function Streak() {
  return (
    <Page>
      <h2>Your Streak</h2>
      <div className="flame">🔥</div>
      <h1>7 Days</h1>

      <div className="calendar">
        {["M", "T", "W", "T", "F", "S", "S"].map((d) => (
          <span key={d}>{d}</span>
        ))}
        {Array.from({ length: 7 }).map((_, i) => (
          <b key={i}>✓</b>
        ))}
      </div>

      <Card title="Next milestone" value="14 days 🌳" />
      <Card title="Freeze Available" value="1" />
    </Page>
  );
}

function Profile() {
  return (
    <Page>
      <h2>Profile</h2>
      <section className="profile">
        <div className="avatar big">A</div>
        <h1>@aohne</h1>
        <p>🔥 7 day streak</p>
        <strong>Level 4 Grasswalker</strong>
      </section>

      <div className="grid">
        <Card title="Offline" value="142h" />
        <Card title="Best" value="15 days" />
        <Card title="Friends" value="18" />
      </div>

      {["Daily Screen Limit", "Blocked Apps", "Notifications", "Privacy"].map(
        (item) => (
          <div className="setting" key={item}>{item}</div>
        )
      )}

      <button className="ghost">Log Out</button>
    </Page>
  );
}

function BottomNav({ screen, setScreen }) {
  const tabs = [
    ["home", Home],
    ["friends", Users],
    ["add", UserPlus],
    ["streak", Flame],
    ["profile", User],
  ];

  return (
    <nav>
      {tabs.map(([id, Icon]) => (
        <button
          key={id}
          onClick={() => setScreen(id)}
          className={screen === id ? "active" : ""}
        >
          <Icon size={22} />
          <span>{id}</span>
        </button>
      ))}
    </nav>
  );
}

function Input({ label, type = "text" }) {
  return <input className="input" type={type} placeholder={label} />;
}

function Card({ title, value }) {
  return (
    <div className="card">
      <p>{title}</p>
      <h3>{value}</h3>
    </div>
  );
}

export default App;
EOF

